rules_version = '2';

// MediPOS security rules. Deploy with:  firebase deploy --only firestore:rules
//
// Permissions come from the database, not from this file.
// Each person may have their own settings in users/{uid}.access:
//   actions: { <screen>: [ "view" | "add" | "edit" | "delete" | "print" ] }
// settings/roles.{role}.actions has the same shape and is the default for everyone in that role.
// If neither is saved, the older lists apply:
//   access.pages / access.write, or else the role's pages / write in settings/roles.
//   pages = screens (view), write = areas where add, edit and delete are allowed.
// Print is checked in the app only (it does not change data).
// Administrators are always allowed everything, so the admin cannot be locked out.
// Field-level limits (e.g. sales staff can change stock but not prices) are enforced here.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── helpers ─────
    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function roleMap() {
      return get(/databases/$(database)/documents/settings/roles).data;
    }
    // Users who must change their temporary password can do nothing else until they do.
    function mustChange() {
      return myProfile().get('mustChangePassword', false) == true;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().active == true
        && myProfile().role == 'admin'
        && !mustChange()
        && otpOk();
    }
    // Active staff whose role exists in settings/roles. Admins do not need the roles document,
    // so an admin can always sign in and create it.
    function isActive() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().active == true
        && !mustChange()
        && myProfile().role in roleMap()
        && otpOk());
    }
    // Staff who must confirm each sign-in with an email code can read nothing until the code is entered.
    function otpOk() {
      return request.auth.token.get('otp', false) == true || myProfile().get('requireOtp', false) != true;
    }
    // A person's own access (set by an administrator). Null means the role's lists apply.
    function ownAccess() {
      return myProfile().get('access', null);
    }
    // Per-screen actions: the person's own actions if they have any; otherwise the role's actions
    // (when the role was saved with actions). Null means the older lists apply.
    function actionsOf() {
      return ownAccess() != null
        ? (('actions' in ownAccess()) ? ownAccess().actions : null)
        : (('actions' in roleMap()[myProfile().role]) ? roleMap()[myProfile().role].actions : null);
    }
    // Older lists: screens (pages) and areas (write). A person's own lists replace the role's lists.
    function listPages() {
      return (ownAccess() != null && 'pages' in ownAccess()) ? ownAccess().pages
        : ('pages' in roleMap()[myProfile().role] ? roleMap()[myProfile().role].pages : []);
    }
    function listWrite() {
      return (ownAccess() != null && 'write' in ownAccess()) ? ownAccess().write
        : ('write' in roleMap()[myProfile().role] ? roleMap()[myProfile().role].write : []);
    }
    // The one check every rule uses: may this active person do this action on this screen?
    // page = a screen name (pos, inventory, purchasing, partners, accounting, reports, returns, dashboard ...)
    // act  = "view" | "add" | "edit" | "delete" | "print"
    function can(page, act) {
      return isAdmin() || (isActive() && (
        actionsOf() != null
          ? (page in actionsOf() && act in actionsOf()[page])
          : ((act == 'view' || act == 'print') ? page in listPages() : page in listWrite())
      ));
    }
    // Shorthands kept for readability in the rules below.
    function canPage(page) {
      return can(page, 'view');
    }
    // Any change at all in an area (used where one rule covers adding, editing and deleting).
    function canWrite(area) {
      return can(area, 'add') || can(area, 'edit') || can(area, 'delete');
    }

    // ───── staff ─────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      // Admins manage profiles. A user may only clear their own "must change password" flag.
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt'])
            && request.resource.data.mustChangePassword == false);
    }

    // ───── public branding (app name, shop name, logo). Contains nothing secret. ─────
    match /branding/public {
      allow read: if true;
      // The logo must be a small embedded PNG, JPEG or WebP image: nothing else can be stored there.
      allow write: if isAdmin()
        && (!('logoUrl' in request.resource.data) || request.resource.data.logoUrl == ''
            || (request.resource.data.logoUrl.size() < 400000
                && request.resource.data.logoUrl.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')));
    }

    // ───── catalogue ─────
    match /products/{id} {
      allow read: if isActive();
      allow create: if can('inventory', 'add');
      allow delete: if can('inventory', 'delete');
      // Inventory staff may change anything. Purchasing may change stock and cost.
      // Sales may only change stock (never prices, names or costs).
      allow update: if can('inventory', 'edit')
        || (can('purchasing', 'edit')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'costPrice', 'updatedAt']))
        || (can('pos', 'edit')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']));
    }
    match /batches/{id} {
      allow read: if isActive();
      allow create: if can('inventory', 'add') || can('purchasing', 'add');
      allow update: if can('inventory', 'edit')
        || (can('pos', 'edit') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining']));
      allow delete: if isAdmin();
    }

    // ───── customers & suppliers ─────
    match /customers/{id} {
      allow read: if isActive();
      allow create: if can('partners', 'add');
      allow update: if can('partners', 'edit')
        || (can('pos', 'edit') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt']));
      allow delete: if isAdmin();
    }
    match /suppliers/{id} {
      allow read: if isActive();
      allow create: if can('purchasing', 'add') || can('partners', 'add');
      allow update: if can('purchasing', 'edit') || can('partners', 'edit');
      allow delete: if isAdmin();
    }

    // ───── transactions (append-only) ─────
    match /sales/{id} {
      allow read: if can('pos', 'view') || can('dashboard', 'view') || can('reports', 'view') || can('accounting', 'view') || can('returns', 'view');
      // A discount above the cashier limit (settings/general.maxDiscountPct) needs an administrator's approval:
      // an approvals/{id} record made for this same cashier, for at least this discount, and not yet expired.
      allow create: if can('pos', 'add') && (
        request.resource.data.discountPct <= get(/databases/$(database)/documents/settings/general).data.get('maxDiscountPct', 100)
        || (request.resource.data.get('approvalId', null) != null
          && exists(/databases/$(database)/documents/approvals/$(request.resource.data.approvalId))
          && get(/databases/$(database)/documents/approvals/$(request.resource.data.approvalId)).data.kind == 'discount'
          && get(/databases/$(database)/documents/approvals/$(request.resource.data.approvalId)).data.requestedBy == request.auth.uid
          && get(/databases/$(database)/documents/approvals/$(request.resource.data.approvalId)).data.pct >= request.resource.data.discountPct
          && get(/databases/$(database)/documents/approvals/$(request.resource.data.approvalId)).data.expiresAt > request.time)
      );
      allow update, delete: if false;
    }
    // Returns and voids are written only by the server, after the approver's password is checked.
    match /returns/{id} {
      allow read: if can('returns', 'view') || can('reports', 'view') || can('accounting', 'view');
      allow create, update, delete: if false;
    }
    match /saleReturns/{id} {
      allow read: if can('returns', 'view');
      allow write: if false;
    }
    // Discount approvals: written by the server only.
    match /approvals/{id} {
      allow read, write: if false;
    }
    match /purchases/{id} {
      match /bills/{bid} {
        allow read: if can('purchasing', 'view') || can('accounting', 'view') || can('reports', 'view');
        // A bill is a photo or PDF of at most about 900 KB, written once with the posting it belongs to.
        allow create: if can('purchasing', 'add')
          && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'data', 'uploadedBy', 'uploadedByUid', 'uploadedAt', 'copied'])
          && request.resource.data.type in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000
          && request.resource.data.copied == false
          && request.resource.data.uploadedByUid == request.auth.uid;
        allow update, delete: if false;
      }
      allow read: if can('purchasing', 'view') || can('reports', 'view') || can('accounting', 'view') || can('partners', 'edit');
      allow create: if can('purchasing', 'add');
      // Paying a supplier only marks bills as paid. Otherwise a posted bill is never changed.
      // Paid can only go up and never beyond the bill total, so a bill cannot be cleared without a payment.
      allow update: if (can('partners', 'edit') || can('purchasing', 'edit'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'status', 'paidAt'])
        && request.resource.data.paid >= resource.data.paid
        && request.resource.data.paid <= resource.data.total;
      allow delete: if false;
    }
    match /journal/{id} {
      // Accounting and reports staff read every voucher. Anyone else reads only the vouchers they posted themselves
      // (the voucher tab opened after a posting). A query must filter on byUid to use the second clause.
      allow read: if can('accounting', 'view') || can('reports', 'view')
        || (isActive() && resource.data.byUid == request.auth.uid);
      // Any staff who post money movements create journal lines through their transaction.
      // A voucher must carry its JV number. Once posted it is never edited or deleted; only its
      // reversal link and status change (when it is reversed or numbered).
      // A voucher has at least two lines (debit and credit).
      allow create: if (can('accounting', 'add') || can('pos', 'add') || can('purchasing', 'add')
        || can('partners', 'add') || can('inventory', 'add'))
        && request.resource.data.jvNo is string
        && request.resource.data.lines is list && request.resource.data.lines.size() >= 2;
      allow update: if can('accounting', 'edit')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jvNo', 'status', 'reversedBy']);
      allow delete: if false;
    }
    match /expenses/{id} {
      match /bills/{bid} {
        allow read: if can('accounting', 'view');
        // A bill is a photo or PDF of at most about 900 KB, written once with the posting it belongs to.
        allow create: if can('accounting', 'add')
          && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'data', 'uploadedBy', 'uploadedByUid', 'uploadedAt', 'copied'])
          && request.resource.data.type in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000
          && request.resource.data.copied == false
          && request.resource.data.uploadedByUid == request.auth.uid;
        allow update, delete: if false;
      }
      allow read: if can('accounting', 'view');
      allow create: if can('accounting', 'add');
      allow update, delete: if false;
    }

    // ───── accounting setup ─────
    match /accounts/{code} {
      allow read: if can('accounting', 'view');
      allow create, update: if can('accounting', 'add') || can('accounting', 'edit');
      allow delete: if can('accounting', 'delete');
    }

    // ───── system ─────
    // Receipt and purchase numbers can only move forward, so they cannot be reset to reuse a number.
    match /counters/{id} {
      allow read: if isActive();
      // Every area that posts to the journal takes a journal voucher number from here.
      allow create: if canWrite('pos') || canWrite('purchasing') || canWrite('accounting') || canWrite('partners') || canWrite('inventory');
      allow update: if (canWrite('pos') || canWrite('purchasing') || canWrite('accounting') || canWrite('partners') || canWrite('inventory'))
        && request.resource.data.get('sale', 0) >= resource.data.get('sale', 0)
        && request.resource.data.get('purchase', 0) >= resource.data.get('purchase', 0)
        && request.resource.data.get('jv', 0) >= resource.data.get('jv', 0);
      allow delete: if false;
    }
    match /settings/general {
      allow read: if isActive();
      allow write: if isAdmin();
    }
    match /settings/roles {
      allow read: if isActive();
      // Administrators must keep access to Administration.
      allow write: if isAdmin() && 'admin' in request.resource.data && 'admin' in request.resource.data.admin.pages;
    }
    match /settings/emails {
      // Email subject and body templates. Read by the server, edited by admins.
      allow read, write: if isAdmin();
    }
    match /floats/{id} {
      // Wallet and operator float balances: sales and top-ups update them; staff who sell or keep accounts can read them.
      allow read: if can('pos', 'view') || can('accounting', 'view') || can('dashboard', 'view');
      allow create, update: if canWrite('pos') || canWrite('accounting');
      // Only administrators delete a float, and only when a wallet or operator is renamed (its balance moves) or removed at zero.
      allow delete: if isAdmin();
    }
    match /notifications/{id} {
      // Bell notifications: each person sees those addressed to their role (admins see all). Anyone active may raise one.
      allow read: if isAdmin() || (isActive() && resource.data.roles.hasAny([myProfile().role]));
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['roles', 'title', 'body', 'kind', 'link', 'readBy', 'createdBy', 'createdAt'])
        && request.resource.data.roles is list
        && request.resource.data.title is string
        && request.resource.data.readBy.size() == 0;
      // Marking as read: a person can only add themselves to readBy.
      allow update: if isActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.auth.uid in request.resource.data.readBy;
      allow delete: if false;
    }
    match /settings/reportSchedules {
      // Scheduled report emails: admins only. The server reads it with full rights.
      allow read, write: if isAdmin();
    }
    match /settings/backupSchedule {
      // Daily backup email settings: admins only. The server reads it with full rights.
      allow read, write: if isAdmin();
    }
    match /settings/integrations {
      // Holds the Google Sheets secret: administrators only. Email keys are NOT stored here any more.
      allow read, write: if isAdmin();
    }
    match /settings/secrets {
      // Email API key and SMTP password. Write-only from the browser: no client can read them back.
      // The server reads them with full rights.
      allow read: if false;
      allow write: if isAdmin();
    }
    // Cash shifts: opened with a counted float and closed with a counted cash figure, by the same person.
    match /shifts/{id} {
      allow read: if isActive();
      allow create: if can('pos', 'add') && request.resource.data.status == 'open' && request.resource.data.openedByUid == request.auth.uid;
      allow update: if can('pos', 'edit') && resource.data.status == 'open' && request.resource.data.status == 'closed'
        && request.resource.data.closedByUid == request.auth.uid
        && request.resource.data.openedByUid == resource.data.openedByUid
        && request.resource.data.openingCash == resource.data.openingCash;
      allow delete: if false;
    }

    // Prescription register: append-only. Sales users record; readers of reports, accounting and the sale screen can view.
    match /prescriptions/{id} {
      allow read: if can('pos', 'view') || can('reports', 'view') || can('accounting', 'view');
      allow create: if can('pos', 'add') && request.resource.data.recordedByUid == request.auth.uid
        && request.resource.data.items is list && request.resource.data.items.size() >= 1;
      allow update, delete: if false;
    }
    // Doctors and clinics used on prescriptions. Sales users add; only administrators remove.
    match /doctors/{id} {
      allow read: if isActive();
      allow create: if can('pos', 'add') && request.resource.data.createdByUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /audit/{id} {
      allow read: if isAdmin();
      // Entries must name the signed-in person, so nobody can write a log entry as someone else.
      allow create: if isActive() && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
