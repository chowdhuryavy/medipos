rules_version = '2';

// MediPOS security rules. Deploy with:  firebase deploy --only firestore:rules
// Access is by staff role stored in users/{uid}. There is no Google sign-in in this app.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── helpers ─────
    function signedIn() {
      return request.auth != null;
    }
    function staff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && staff().active == true
        && staff().role in ['admin', 'pharmacist', 'cashier', 'storekeeper', 'accountant'];
    }
    function hasRole(roles) {
      return isActive() && staff().role in roles;
    }

    // ───── staff ─────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasRole(['admin']));
      allow create, update, delete: if hasRole(['admin']);
    }

    // ───── catalogue ─────
    match /products/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['admin', 'pharmacist', 'storekeeper', 'cashier']);
      allow delete: if hasRole(['admin']);
    }
    match /batches/{id} {
      allow read: if isActive();
      allow create: if hasRole(['admin', 'pharmacist', 'storekeeper']);
      allow update: if hasRole(['admin', 'pharmacist', 'storekeeper', 'cashier']);
      allow delete: if hasRole(['admin']);
    }

    // ───── customers & suppliers ─────
    match /customers/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['admin', 'pharmacist', 'cashier', 'accountant']);
      allow delete: if hasRole(['admin']);
    }
    match /suppliers/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['admin', 'pharmacist', 'storekeeper', 'accountant']);
      allow delete: if hasRole(['admin']);
    }

    // ───── transactions (append-only) ─────
    match /sales/{id} {
      allow read: if hasRole(['admin', 'pharmacist', 'cashier', 'accountant']);
      allow create: if hasRole(['admin', 'pharmacist', 'cashier']);
      allow update, delete: if false;
    }
    match /purchases/{id} {
      allow read: if hasRole(['admin', 'pharmacist', 'storekeeper', 'accountant']);
      allow create: if hasRole(['admin', 'pharmacist', 'storekeeper']);
      allow update, delete: if false;
    }
    match /journal/{id} {
      allow read: if hasRole(['admin', 'accountant']);
      allow create: if isActive();
      allow update, delete: if false;
    }
    match /expenses/{id} {
      allow read, create: if hasRole(['admin', 'accountant']);
      allow update, delete: if false;
    }

    // ───── accounting setup ─────
    match /accounts/{code} {
      allow read, write: if hasRole(['admin', 'accountant']);
    }

    // ───── system ─────
    match /counters/{id} {
      allow read, write: if isActive();
    }
    match /settings/general {
      allow read: if isActive();
      allow write: if hasRole(['admin']);
    }
    match /settings/roles {
      allow read: if isActive();
      allow write: if hasRole(['admin']);
    }
    match /settings/integrations {
      allow read: if hasRole(['admin', 'accountant']);
      allow write: if hasRole(['admin']);
    }
    match /audit/{id} {
      allow read: if hasRole(['admin']);
      allow create: if isActive();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
